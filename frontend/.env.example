# =========================================================================
# Turf Booking System - Frontend Environment Variables Template
# =========================================================================
# Copy this file to a new file named '.env' in this same directory.
# Adjust the values below to match your local or production environment.

# 1. API Backend Gateway URL
# - Local Development: baseURL: import.meta.env.VITE_API_URL
# - Production (Render Backend): https://your-backend-slug.onrender.com/api
VITE_API_URL=baseURL: import.meta.env.VITE_API_URL

# 2. Razorpay Key ID (For checkout integrations)
# - Set this to your Razorpay Sandbox/Live API key ID.
# - Safe to expose on frontend because it is a public key identifier.
VITE_RAZORPAY_KEY_ID=rzp_test_abc123XYZ

# -------------------------------------------------------------------------
# NOTE FOR PRODUCTION DEPLOYMENT (e.g., Vercel / Netlify):
# -------------------------------------------------------------------------
# Set VITE_API_URL inside your Vercel Dashboard -> Project Settings -> Environment Variables.
# For example:
# VITE_API_URL=https://turf-booking-backend.onrender.com/api
# V========================================================================
